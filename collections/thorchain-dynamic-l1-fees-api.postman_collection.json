      "item": [
        {
          "id": "1f55b4a3-e5dd-4915-a92b-e3b05eb9df78",
          "name": "dynamic L1Fees",
          "request": {
            "name": "dynamic L1Fees",
            "description": {
              "content": "Returns every stored dynamic L1 fee record (ADR-026). Each entry is a\nthorname/pair tuple with its current `dynamic_bps`, whitelist state,\nlast active epoch, and latest sealed-epoch fees in TOR (1e8-precision\nUSD value).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "thorchain",
                "dynamic_l1_fees"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "height",
                  "value": "<long>",
                  "description": "optional block height, defaults to current tip"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "e549bba2-0848-4a8c-b645-c20b38a8ea0c",
              "name": "OK",
              "originalRequest": {
                "url": {
                  "path": [
                    "thorchain",
                    "dynamic_l1_fees"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "height",
                      "value": "<long>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"entries\": [\n    {\n      \"thorname\": \"alice\",\n      \"pair\": \"BTC.BTC|THOR.RUNE\",\n      \"dynamic_bps\": 12,\n      \"whitelist_state\": 1,\n      \"last_active_epoch\": 42,\n      \"latest_fees_tor\": \"12345678\"\n    },\n    {\n      \"thorname\": \"alice\",\n      \"pair\": \"BTC.BTC|THOR.RUNE\",\n      \"dynamic_bps\": 12,\n      \"whitelist_state\": 1,\n      \"last_active_epoch\": 42,\n      \"latest_fees_tor\": \"12345678\"\n    }\n  ]\n}",
              "cookie": [],
