              "body": "{\n  \"thorname\": \"alice\",\n  \"whitelist_state\": 1,\n  \"pairs\": [\n    {\n      \"pair\": \"BTC.BTC|THOR.RUNE\",\n      \"dynamic_bps\": 12,\n      \"last_active_epoch\": 42,\n      \"history\": [\n        {\n          \"epoch\": 41,\n          \"volume_tor\": \"10000000000\",\n          \"fees_tor\": \"12345678\",\n          \"bps_at_close\": 12\n        },\n        {\n          \"epoch\": 41,\n          \"volume_tor\": \"10000000000\",\n          \"fees_tor\": \"12345678\",\n          \"bps_at_close\": 12\n        }\n      ]\n    },\n    {\n      \"pair\": \"BTC.BTC|THOR.RUNE\",\n      \"dynamic_bps\": 12,\n      \"last_active_epoch\": 42,\n      \"history\": [\n        {\n          \"epoch\": 41,\n          \"volume_tor\": \"10000000000\",\n          \"fees_tor\": \"12345678\",\n          \"bps_at_close\": 12\n        },\n        {\n          \"epoch\": 41,\n          \"volume_tor\": \"10000000000\",\n          \"fees_tor\": \"12345678\",\n          \"bps_at_close\": 12\n        }\n      ]\n    }\n  ]\n}",
              "cookie": [],
