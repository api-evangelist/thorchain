        {
          "id": "5484f69b-a690-400f-a8cc-d9c45b9e913f",
          "name": "dynamic L1Fees By Thorname",
          "request": {
            "name": "dynamic L1Fees By Thorname",
            "description": {
              "content": "Returns the dynamic L1 fee state and full epoch history for every\npair tracked for the given thorname (ADR-026).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "thorchain",
                "dynamic_l1_fees",
                ":thorname"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "height",
                  "value": "<long>",
                  "description": "optional block height, defaults to current tip"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "thorname",
                  "description": "(Required) the thorname to look up dynamic fee state for"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
