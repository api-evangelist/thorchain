                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the state of a streaming swap"
        },
        {
          "info": {
            "name": "stream_swaps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/thorchain/swaps/streaming",
            "params": [
              {
                "name": "height",
                "value": "",
                "type": "query",
                "description": "optional block height, defaults to current tip"
              }
            ]
          },
          "docs": "Returns the state of all streaming swaps"
