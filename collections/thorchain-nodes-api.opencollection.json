{
  "opencollection": "1.0.0",
  "info": {
    "name": "Thornode Auth Nodes API",
    "version": "3.19.1"
  },
  "items": [
    {
      "info": {
        "name": "Nodes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Nodes List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/nodes"
          },
          "docs": "Returns a list of Node public keys and adresses."
        },
        {
          "info": {
            "name": "node",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/thorchain/node/:address",
            "params": [
              {
                "name": "height",
                "value": "",
                "type": "query",
                "description": "optional block height, defaults to current tip"
              },
              {
                "name": "address",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns node information for the provided node address."
        },
        {
          "info": {
            "name": "nodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/thorchain/nodes",
            "params": [
              {
                "name": "height",
                "value": "",
                "type": "query",
                "description": "optional block height, defaults to current tip"
              }
            ]
          },
          "docs": "Returns node information for all registered validators."
        }
      ]
    }
  ],
  "bundled": true
}