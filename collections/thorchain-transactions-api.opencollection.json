          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/thorchain/tx/stages/:hash",
            "params": [
              {
                "name": "height",
                "value": "",
                "type": "query",
                "description": "optional block height, defaults to current tip"
